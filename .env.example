# Environment Variables
# Copy this file to .env and fill in the values

# PostgreSQL Database URL
DATABASE_URL="postgresql://user:password@localhost:5432/polaris?schema=public"

# LLM API Key (for extraction pipeline)
# Supports Google Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"

# Admin credentials (used to seed the first admin)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="polaris-admin-2026"

# NextAuth secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="change-me-to-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

