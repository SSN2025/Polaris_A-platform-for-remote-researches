# Copy this file to .env.local and set your own values.

# Admin panel login password. Falls back to "polaris2026" if unset
# (change this before any real deployment).
ADMIN_PASSWORD=polaris2026

# Secret used to sign admin session cookies. Falls back to an
# insecure dev-only value if unset — MUST be set to a long random
# string before deploying anywhere public. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
